# Build output. `-Map=target/kernel.map` from kernel/build.rs lands here too.
/target
# `user/` is its own workspace, so it has its own build directory. The nested
# build from kernel/build.rs writes into OUT_DIR; this is for building it by hand.
/user/target

# Device tree dumps from `qemu-system-riscv64 -machine dumpdtb=virt.dtb`.
# Regenerated on demand, never edited by hand.
*.dtb
*.dts

# Editor and tooling scratch
.vscode/
.idea/
*.swp
*~
.gdb_history

# Cargo.lock is deliberately NOT ignored: tessera builds a binary, and the
# whole point of pinning the toolchain (D-001) is that a clone reproduces our
# build exactly. Ignoring the lockfile would undo half of that.
